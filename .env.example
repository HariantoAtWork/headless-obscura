# Docker Hub namespace for the runtime image (docker-compose.yml)
DOCKERHUB_USERNAME=harianto

# Host port published by docker-compose (host:container = OBSCURA_HOST_PORT:9222)
OBSCURA_HOST_PORT=9222

# CDP bind address passed to `obscura serve --host` (skip socat when set)
HOST=0.0.0.0

# Public port inside the container
OBSCURA_PORT=9222

# Internal Obscura CDP port used only when HOST is unset (socat tunnel)
OBSCURA_INTERNAL_PORT=9223